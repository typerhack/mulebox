# mulebox GitHub Actions runner, one instance per runner: mulebox-runner@<name>.service.
# Installed (not enabled) by install.sh into ~/.config/systemd/user/; `mulebox runner add`
# enables and starts an instance. %h is the user's home folder, %i the runner name.
[Unit]
Description=mulebox GitHub Actions runner %i
After=mulebox-worker.service

[Service]
Type=simple
WorkingDirectory=%h/.mulebox/runners/%i
ExecStart=%h/.mulebox/runners/%i/run.sh
# run.sh passes a stop on to the listener only with this set; without it a stop ended run.sh
# alone, and a restart left the old listener running beside the new one. `mixed` then kills
# whatever is still in the unit once run.sh is gone, so a restart never leaves a second listener.
Environment=RUNNER_MANUALLY_TRAP_SIG=1
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5min
Restart=always
RestartSec=10
# The same share as a mulebox job's unit (worker/systemd.py): CI and agents' jobs are equals,
# and both yield to the machine's own use.
CPUWeight=50
IOWeight=50

[Install]
WantedBy=default.target
