# mulebox worker: claims queued jobs and runs them. Installed by install.sh into
# ~/.config/systemd/user/. %h is the user's home folder.
[Unit]
Description=mulebox worker (runs queued jobs)
After=mulebox-coordinator.service

[Service]
Type=simple
ExecStart=%h/.mulebox/bin/mulebox worker serve
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
