# mulebox node config for a build machine: ~/.config/mulebox/node.toml
#
# install.sh writes this file once, from this template, if it does not exist yet; it
# never overwrites it. It fills in the machine's short hostname as `name` and the home
# folder in the roots. Unknown keys are errors. See docs/install.md.

# Name of this node in the queue and the logs (letters, digits, '.', '_', '-').
name = "@NAME@"

# Both roles run on one machine, as two systemd user services.
roles = ["coordinator", "worker"]

# Jobs this node runs at the same time.
slots = 1

# What this node offers to jobs (`needs` in a project's .mulebox.yml), e.g. ["docker"].
capabilities = []

# mulebox only creates and deletes files inside these folders. Keep them separate and
# outside system paths; they must not be your home folder itself.
[roots]
jobs = "@HOME@/.mulebox/jobs"
projects = "@HOME@/.mulebox/projects"
cache = "@HOME@/.mulebox/cache"
staging = "@HOME@/.mulebox/staging"
runners = "@HOME@/.mulebox/runners"

# Web dashboard: "off", "local" (this machine only) or "lan" (also on the LAN, with a
# password unless lan_password = false). "lan" needs lan_range and lan_address; see
# docs/install.md.
[dashboard]
mode = "local"
port = 8090
# lan_range = "192.168.1.0/24"
# lan_address = "192.168.1.50"
# lan_port = 9443              # only for a different port; the default is `port`
# lan_tls = false
# lan_password = true
# A cancel button on a job's page, for signed-in users on the LAN address. Needs mode = "lan"
# and a password; without them there is no button.
# cancel_button = false

# Environment for every job on this machine, for what the machine needs and no project
# should have to know; a project's `env:` can override it. Not for secrets: it ends up in
# job processes. See docs/install.md.
# [job_env]
# NODE_OPTIONS = "--network-family-autoselection-attempt-timeout=5000"
